{
  "name": "web-search-engine",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "web/dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI", "remote": true },
  // 30 uncached semantic searches a minute per visitor.
  "ratelimits": [{ "name": "LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "web-search", "remote": true }],
  "routes": [{ "pattern": "search.tahamukhtar.com", "custom_domain": true }]
}
